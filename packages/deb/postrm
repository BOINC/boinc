set -e

# Completes removal of the obsolete /etc/init.d/boinc-client conffile started
# in preinst. rm_conffile must be called from preinst, postinst and postrm so
# the removal is handled correctly across upgrade and rollback. See #7272.
if command -v dpkg-maintscript-helper >/dev/null 2>&1 \
    && dpkg-maintscript-helper supports rm_conffile; then
    dpkg-maintscript-helper rm_conffile /etc/init.d/boinc-client -- "$@"
fi
